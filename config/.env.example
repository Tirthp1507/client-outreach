# =============================================================================
# REAL EMAIL SMTP CONFIGURATION FOR B2B CLIENT OUTREACH
# =============================================================================
# Copy this file to `config/.env` and fill in your real SMTP credentials.
# The system will automatically load these environment overrides.

# 1. Gmail SMTP Setup (Recommended for initial testing):
#    - Enable 2-Step Verification on your Google Account.
#    - Generate an App Password under Google Security -> App Passwords.
#    - Use host: smtp.gmail.com, port: 587.

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-agency-email@gmail.com
EMAIL_SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM_EMAIL=your-agency-email@gmail.com
EMAIL_FROM_NAME="Growth Team | Your Agency"
EMAIL_USE_TLS=true

# 2. Alternative SMTP Providers (SendGrid, Amazon SES, Postmark, Mailgun):
#    - SendGrid: host=smtp.sendgrid.net, username=apikey, password=SG.xxx
#    - Amazon SES: host=email-smtp.us-east-1.amazonaws.com, username=AKIAxxx, password=xxx

# =============================================================================
# REAL PRODUCTION SEARCH & EMAIL VERIFICATION API KEYS
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
HUNTER_API_KEY=your_hunter_io_key_here